# Python
__pycache__/
*.py[cod]

# Virtual environments
.venv/
__pypackages__/

# Build artifacts
build/
dist/
*.egg-info/
pip-wheel-metadata/

# Testing and coverage
.pytest_cache/
.coverage*
coverage.xml
htmlcov/

# Type checking and linting
.mypy_cache/
.ruff_cache/

# Task runner
.nox/

# Package manager
#
# The lock file is committed, so it is deliberately not ignored, giving reproducible installs
# in development and CI.
.pdm-python
.pdm.toml
# PDM resolves and installs with uv but keeps its own lock, so a uv lock file is never wanted.
uv.lock

# Documentation
site/
docs/generated/

# IDE and editors
.idea/
.vscode/

# OS
.DS_Store
