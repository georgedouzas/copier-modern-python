{%- set versions = python_test_versions -%}
name: CI

on:
  push:
    branches:
      - '**'
  workflow_dispatch:
  workflow_call:

permissions:
  contents: read

jobs:

  checks:

    strategy:
      matrix:
        os:
        - ubuntu-latest
        - macos-latest
        - windows-latest

    runs-on: {% raw %}${{ matrix.os }}{% endraw %}

    steps:
    - name: Checkout
      uses: actions/checkout@v7

    - name: Install Python versions
      uses: actions/setup-python@v7
      with:
        python-version: |
            {%- for version in versions %}
            {{ version }}
            {%- endfor %}

    {% if package_manager == "PDM" -%}
    - name: Set up PDM
      uses: pdm-project/setup-pdm@v4
      with:
        cache: true
        cache-dependency-path: pyproject.toml

    - name: Set up uv
      uses: astral-sh/setup-uv@v5

    - name: Install dependencies
      run: pdm install --no-default -dG maintenance -dG checks

    - name: Check code quality
      run: pdm checks quality

    - name: Check type annotations
      run: pdm checks types

    - name: Check vulnerabilities in dependencies
      run: pdm checks dependencies

    - name: Check security issues
      run: pdm checks security

    - name: Check docstring coverage
      run: pdm checks docs
    {%- else -%}
    - name: Set up uv
      uses: astral-sh/setup-uv@v10
      with:
        enable-cache: true
        cache-dependency-glob: pyproject.toml

    - name: Install dependencies
      run: uv sync --only-dev

    - name: Check code quality
      run: uv run nox -s checks -- quality

    - name: Check type annotations
      run: uv run nox -s checks -- types

    - name: Check vulnerabilities in dependencies
      run: uv run nox -s checks -- dependencies

    - name: Check security issues
      run: uv run nox -s checks -- security

    - name: Check docstring coverage
      run: uv run nox -s checks -- docs
    {%- endif %}

  tests:

    strategy:
      matrix:
        os:
        - ubuntu-latest
        - macos-latest
        - windows-latest

    runs-on: {% raw %}${{ matrix.os }}{% endraw %}

    steps:
    - name: Checkout
      uses: actions/checkout@v7

    - name: Install Python versions
      uses: actions/setup-python@v7
      with:
        python-version: |
            {%- for version in versions %}
            {{ version }}
            {%- endfor %}

    {% if package_manager == "PDM" -%}
    - name: Set up PDM
      uses: pdm-project/setup-pdm@v4
      with:
        cache: true
        cache-dependency-path: pyproject.toml

    - name: Set up uv
      uses: astral-sh/setup-uv@v5

    - name: Install dependencies
      run: pdm install -dG maintenance -dG tests

    - name: Run the test suite
      run: pdm tests
    {%- else -%}
    - name: Set up uv
      uses: astral-sh/setup-uv@v10
      with:
        enable-cache: true
        cache-dependency-glob: pyproject.toml

    - name: Install dependencies
      run: uv sync

    - name: Run the test suite
      run: uv run nox -s tests
    {%- endif %}

  doc:

    if: {% raw %}${{ github.ref != 'refs/heads/main' }}{% endraw %}

    runs-on: ubuntu-latest

    strategy:
      matrix:
        python-version: {{ versions }}

    steps:
    - name: Checkout
      uses: actions/checkout@v7

    {% if package_manager == "PDM" -%}
    - name: Set up PDM
      uses: pdm-project/setup-pdm@v4
      with:
        cache: true
        cache-dependency-path: pyproject.toml

    - name: Set up uv
      uses: astral-sh/setup-uv@v5

    - name: Install dependencies
      run: pdm install -dG maintenance -dG docs

    - name: Build documentation with Python {% raw %}${{ matrix.python-version }}{% endraw %}
      run: pdm docs build
    {%- else -%}
    - name: Set up uv
      uses: astral-sh/setup-uv@v10
      with:
        enable-cache: true
        cache-dependency-glob: pyproject.toml
        python-version: {% raw %}${{ matrix.python-version }}{% endraw %}

    - name: Install dependencies
      run: uv sync

    - name: Build documentation with Python {% raw %}${{ matrix.python-version }}{% endraw %}
      run: uv run nox -s docs -- build
    {%- endif %}
