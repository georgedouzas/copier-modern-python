trigger:
  branches:
    include:
      - '*'
  tags:
    include:
      - '*'

pool:
  vmImage: 'ubuntu-latest'

variables:
  pythonVersion: '{{ python_test_versions[0] }}'

stages:
- stage: Test
  jobs:
  - job: TestJob
    steps:
    - task: UsePythonVersion@0
      inputs:
        versionSpec: '$(pythonVersion)'
      displayName: 'Use Python $(pythonVersion)'

    - script: |
        python -m pip install --upgrade pip
        {%- if package_manager == "PDM" %}
        pip install pdm uv
        {%- else %}
        pip install uv
        {%- endif %}
      displayName: 'Install dependencies'

    - script: |
        {%- if package_manager == "PDM" %}
        pdm install
        pdm run tests
        {%- else %}
        uv sync
        uv run nox -s tests
        {%- endif %}
      displayName: 'Run tests'

- stage: Quality
  dependsOn: Test
  jobs:
  - job: QualityJob
    steps:
    - task: UsePythonVersion@0
      inputs:
        versionSpec: '$(pythonVersion)'
      displayName: 'Use Python $(pythonVersion)'

    - script: |
        python -m pip install --upgrade pip
        {%- if package_manager == "PDM" %}
        pip install pdm uv
        {%- else %}
        pip install uv
        {%- endif %}
      displayName: 'Install dependencies'

    - script: |
        {%- if package_manager == "PDM" %}
        pdm install
        pdm run checks
        {%- else %}
        uv sync
        uv run nox -s checks
        {%- endif %}
      displayName: 'Run quality checks'

- stage: Docs
  dependsOn: Quality
  condition: and(succeeded(), eq(variables['Build.SourceBranch'], 'refs/heads/main'))
  jobs:
  - job: DocsJob
    steps:
    - task: UsePythonVersion@0
      inputs:
        versionSpec: '$(pythonVersion)'
      displayName: 'Use Python $(pythonVersion)'

    - script: |
        python -m pip install --upgrade pip
        {%- if package_manager == "PDM" %}
        pip install pdm uv
        {%- else %}
        pip install uv
        {%- endif %}
      displayName: 'Install dependencies'

    - script: |
        {%- if package_manager == "PDM" %}
        pdm install
        pdm run docs build
        {%- else %}
        uv sync
        uv run nox -s docs -- build
        {%- endif %}
      displayName: 'Build documentation'

    - task: PublishBuildArtifacts@1
      inputs:
        pathToPublish: 'site'
        artifactName: 'documentation'

{%- if publish_pypi %}
# The Docs stage is skipped on tag builds, so the release depends on the stages
# that do run there. This is what gates publishing on a green test suite.
- stage: Release
  dependsOn:
    - Test
    - Quality
  condition: and(succeeded(), startsWith(variables['Build.SourceBranch'], 'refs/tags/'))
  jobs:
  - job: ReleaseJob
    steps:
    - task: UsePythonVersion@0
      inputs:
        versionSpec: '$(pythonVersion)'
      displayName: 'Use Python $(pythonVersion)'

    - script: |
        python -m pip install --upgrade pip
        {%- if package_manager == "PDM" %}
        pip install pdm uv twine
        {%- else %}
        pip install uv twine
        {%- endif %}
      displayName: 'Install dependencies'

    # The `release` nox session is the local kickoff that tags the commit. The
    # pipeline is the only publisher, so it just builds and uploads the tag.
    - script: |
        {%- if package_manager == "PDM" %}
        pdm build
        {%- else %}
        uv build
        {%- endif %}
        twine upload --skip-existing dist/*
      displayName: 'Release to PyPI'
      env:
        TWINE_USERNAME: $(TWINE_USERNAME)
        TWINE_PASSWORD: $(TWINE_PASSWORD)
{%- endif %}
