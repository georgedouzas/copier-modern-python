[build-system]
{% if package_manager == "PDM" -%}
requires = ["pdm-backend"]
build-backend = "pdm.backend"
{% else -%}
requires = ["hatchling", "hatch-vcs"]
build-backend = "hatchling.build"
{% endif %}
[project]
name = "{{ python_package_distribution_name }}"
description = "{{ project_description }}"
authors = [{name = "{{ author_fullname }}", email = "{{ author_email }}"}]
{% if copyright_license != "None" -%}
license = "
    {%- if copyright_license == "Academic Free License v3.0" -%}
    AFL-3.0
    {%- elif copyright_license == "Apache License 2.0" -%}
    Apache-2.0
    {%- elif copyright_license == "Artistic License 2.0" -%}
    Artistic-2.0
    {%- elif copyright_license == "BSD 2-Clause \"Simplified\" License" -%}
    BSD-2-Clause
    {%- elif copyright_license == "BSD 3-Clause Clear License" -%}
    BSD-3-Clause-Clear
    {%- elif copyright_license == "BSD 3-Clause \"New\" or \"Revised\" License" -%}
    BSD-3-Clause
    {%- elif copyright_license == "Boost Software License 1.0" -%}
    BSL-1.0
    {%- elif copyright_license == "Creative Commons Attribution 4.0" -%}
    CC-BY-4.0
    {%- elif copyright_license == "Creative Commons Attribution Share Alike 4.0" -%}
    CC-BY-SA-4.0
    {%- elif copyright_license == "Creative Commons Zero v1.0 Universal" -%}
    CC0-1.0
    {%- elif copyright_license == "Do What The F*ck You Want To Public License" -%}
    WTFPL
    {%- elif copyright_license == "Educational Community License v2.0" -%}
    ECL-2.0
    {%- elif copyright_license == "Eclipse Public License 1.0" -%}
    EPL-1.0
    {%- elif copyright_license == "Eclipse Public License 2.0" -%}
    EPL-2.0
    {%- elif copyright_license == "European Union Public License 1.1" -%}
    EUPL-1.1
    {%- elif copyright_license == "European Union Public License 1.2" -%}
    EUPL-1.2
    {%- elif copyright_license == "GNU Affero General Public License v3.0" -%}
    AGPL-3.0
    {%- elif copyright_license == "GNU General Public License v2.0" -%}
    GPL-2.0
    {%- elif copyright_license == "GNU General Public License v3.0" -%}
    GPL-3.0
    {%- elif copyright_license == "GNU Lesser General Public License v2.1" -%}
    LGPL-2.1
    {%- elif copyright_license == "GNU Lesser General Public License v3.0" -%}
    LGPL-3.0
    {%- elif copyright_license == "ISC License" -%}
    ISC
    {%- elif copyright_license == "LaTeX Project Public License v1.3c" -%}
    LPPL-1.3c
    {%- elif copyright_license == "MIT License" -%}
    MIT
    {%- elif copyright_license == "Mozilla Public License 2.0" -%}
    MPL-2.0
    {%- elif copyright_license == "Microsoft Public License" -%}
    MS-PL
    {%- elif copyright_license == "Microsoft Reciprocal License" -%}
    MS-RL
    {%- elif copyright_license == "University of Illinois/NCSA Open Source License" -%}
    NCSA
    {%- elif copyright_license == "SIL Open Font License 1.1" -%}
    OFL-1.1
    {%- elif copyright_license == "Open Software License 3.0" -%}
    OSL-3.0
    {%- elif copyright_license == "PostgreSQL License" -%}
    PostgreSQL
    {%- elif copyright_license == "The Unlicense" -%}
    Unlicense
    {%- elif copyright_license == "zlib License" -%}
    Zlib
    {%- endif %}"
{% endif -%}
readme = "README.md"
requires-python = "{{ python_versions }}"
keywords = []
dynamic = ["version"]
classifiers = [
    "Development Status :: 4 - Beta",
    "Intended Audience :: Developers",
    "Programming Language :: Python",
    "Programming Language :: Python :: 3",
    "Programming Language :: Python :: 3 :: Only",
    {% for version in python_test_versions -%}
    "Programming Language :: Python :: {{ version }}",
    {% endfor -%}
    "Topic :: Documentation",
    "Topic :: Software Development",
    "Topic :: Utilities",
    "Typing :: Typed",
]
{% set namespace_path = repository_namespace | urlencode if repository_namespace is defined else "" -%}
{% set repo_path = repository_name | urlencode -%}
{% if project_layout == "script" -%}
dependencies = [
    "click>=8.1.3",
]
{% elif project_layout == "ml" -%}
dependencies = [
    "metaflow>=2.19",
]
{% elif project_layout == "dataeng" -%}
dependencies = [
    "kedro>=1.5",
]
{% elif project_layout == "service" -%}
dependencies = [
    "fastapi>=0.115",
    "pydantic>=2.0",
    "uvicorn[standard]>=0.34",
]
{% else -%}
dependencies = []
{% endif -%}
{% if git_provider != "None" %}
[project.urls]
{% if git_provider == "GitHub" -%}
Homepage = "https://{{ namespace_path }}.github.io/{{ repo_path }}"
Documentation = "https://{{ namespace_path }}.github.io/{{ repo_path }}"
Changelog = "https://{{ namespace_path }}.github.io/{{ repo_path }}/changelog"
Repository = "https://github.com/{{ namespace_path }}/{{ repo_path }}"
Issues = "https://github.com/{{ namespace_path }}/{{ repo_path }}/issues"
Discussions = "https://github.com/{{ namespace_path }}/{{ repo_path }}/discussions"
{% elif git_provider == "GitLab" -%}
Homepage = "https://{{ namespace_path }}.gitlab.io/{{ repo_path }}"
Documentation = "https://{{ namespace_path }}.gitlab.io/{{ repo_path }}"
Changelog = "https://{{ namespace_path }}.gitlab.io/{{ repo_path }}/changelog"
Repository = "https://gitlab.com/{{ namespace_path }}/{{ repo_path }}"
Issues = "https://gitlab.com/{{ namespace_path }}/{{ repo_path }}/-/issues"
{% elif git_provider == "Azure DevOps" -%}
Repository = "https://dev.azure.com/{{ namespace_path }}/{{ azure_devops_project | urlencode }}/_git/{{ repo_path }}"
{% elif git_provider == "Bitbucket" -%}
Repository = "https://bitbucket.org/{{ namespace_path }}/{{ repo_path }}"
Issues = "https://bitbucket.org/{{ namespace_path }}/{{ repo_path }}/issues"
{% endif -%}
{% endif -%}
{% if project_layout == "script" %}
[project.scripts]
{{ repository_name }} = "{{ python_package_import_name }}.cli:main"
{% endif -%}
{% if package_manager == "PDM" %}
[tool.pdm.version]
source = "scm"

[tool.pdm.build]
package-dir = "src"
editable-backend = "path"

[tool.pdm.scripts]
clean = "nox --error-on-external-run -R -s clean"
docs = "nox --error-on-external-run -R -s docs -- {args:serve}"
formatting = "nox --error-on-external-run -R -s formatting -- {args:all}"
checks = "nox --default-venv-backend uv --error-on-external-run -R -s checks -- {args:all}"
tests = "nox --default-venv-backend uv --error-on-external-run -R -s tests"
changelog = "nox --error-on-external-run -R -s changelog"
release = "nox --error-on-external-run -R -s release"

[tool.pdm.dev-dependencies]
maintenance = [
    "nox[uv]>=2024.4.15",
]
docs = [
    "properdocs>=1.6.7",
    "mkdocs-coverage>=1.1.0",
    "mkdocs-gen-files>=0.5.0",
    "mkdocs-literate-nav>=0.6.1",
    "mkdocs-material>=9.5.27",
    "mkdocs-gallery>=0.10.1",
    "mkdocs-section-index>=0.3.9",
    "mkdocstrings[python]>=0.25.1",
    "markdown-callouts>=0.4.0",
    "markdown-exec>=1.9.3",
    'pandas>=2.2.2',
    {%- if project_layout == "ml" %}
    "mkdocs-jupyter>=0.26.3",
    {%- endif %}
]
formatting = [
    "black>=24.4.2",
    "docformatter>=1.7.5",
]
checks = [
    "ruff>=0.5.0",
    "pip-audit>=2.7.3",
    "bandit[toml]>=1.7.5",
    "mypy>=1.10.1",
    "types-markdown>=3.6.0.20240316",
    "types-toml>=0.10.8.20240310",
    "interrogate>=1.7.0",
    "pydoclint>=0.9.1",
    "deptry>=0.25.1",
]
tests = [
    "pytest>=8.2.2",
    "pytest-cov>=5.0.0",
    "pytest-randomly>=3.15.0",
    "pytest-xdist>=3.6.1",
    {%- if project_layout == "ml" %}
    "ipykernel>=6.29.0",
    "nbmake>=1.5.0",
    {%- endif %}
    {%- if project_layout == "service" %}
    "httpx>=0.28.0",
    {%- endif %}
]
changelog = [
    "git-changelog>=2.5.2",
]
{% if publish_pypi -%}
release = [
    "twine>=5.1.1",
]
{% endif -%}
{% else -%}
[dependency-groups]
dev = [
    "properdocs>=1.6.7",
    "mkdocs-coverage>=1.1.0",
    "mkdocs-gen-files>=0.5.0",
    "mkdocs-literate-nav>=0.6.1",
    "mkdocs-material>=9.5.27",
    "mkdocs-gallery>=0.10.1",
    "mkdocs-section-index>=0.3.9",
    "mkdocstrings[python]>=0.25.1",
    "markdown-callouts>=0.4.0",
    "markdown-exec>=1.9.3",
    "pandas>=2.2.2",
    {%- if project_layout == "ml" %}
    "mkdocs-jupyter>=0.26.3",
    {%- endif %}
    "black>=24.4.2",
    "docformatter>=1.7.5",
    "ruff>=0.5.0",
    "pip-audit>=2.7.3",
    "bandit[toml]>=1.7.5",
    "mypy>=1.10.1",
    "types-markdown>=3.6.0.20240316",
    "types-toml>=0.10.8.20240310",
    "interrogate>=1.7.0",
    "pydoclint>=0.9.1",
    "deptry>=0.25.1",
    "pytest>=8.2.2",
    "pytest-cov>=5.0.0",
    "pytest-randomly>=3.15.0",
    "pytest-xdist>=3.6.1",
    {%- if project_layout == "ml" %}
    "ipykernel>=6.29.0",
    "nbmake>=1.5.0",
    {%- endif %}
    {%- if project_layout == "service" %}
    "httpx>=0.28.0",
    {%- endif %}
    "git-changelog>=2.5.2",
    {%- if publish_pypi %}
    "twine>=5.1.1",
    {%- endif %}
    "nox[uv]>=2024.4.15",
]

[tool.hatch.version]
source = "vcs"

[tool.hatch.build.targets.wheel]
packages = ["src/{{ python_package_import_name }}"]
{% endif %}
{% set version = python_test_versions[0].split('.')[1] -%}
[tool.black]
line-length = 120
extend-exclude = "(tests/fixtures|docs/generated)"
skip-string-normalization = true
target-version = ["py3{{ version }}"]

[tool.docformatter]
in-place = true
recursive = true
close-quotes-on-newline = true
wrap-descriptions = 120
wrap-summaries = 120

[tool.ruff]
extend-exclude = ["docs/generated"]
force-exclude = true
line-length = 120
target-version = "py3{{ version }}"

[tool.ruff.lint]
ignore = ["D202", "N806", "N803", "S101", "INP001", "Q000", "TRY002", "PLR0913", "EXE001", "EXE002", "E741"]
select = ["C", "E", "F", "W", "B", "I", "D", "N", "UP", "YTT", "ANN", "S",
"BLE", "A", "COM", "C4", "DTZ", "T10", "EM", "EXE", "ISC", "ICN", "G",
"INP", "PIE", "T20", "PT", "Q", "RET501", "RET502", "RET503", "SIM",
"PTH", "PD", "PGH", "PL", "TRY", "RUF", "PLE", "PLR", "PLW", "TRY", "RUF"]

[tool.ruff.lint.per-file-ignores]
"docs/examples/*" = ["ANN", "D", "B018"]
"docs/generated/*" = ["ANN", "D"]
"test_*" = ["ANN"]
{%- if project_layout == "ml" %}
# Notebooks are worked in, not written like library code: printing is the point, annotations
# and module docstrings are noise, and a bare expression is how you look at a value.
"notebooks/*" = ["ANN", "D", "T20", "B018", "INP001"]
{%- endif %}

[tool.ruff.lint.pydocstyle]
convention = "google"

[tool.mypy]
ignore_missing_imports = true
exclude = ["tests/fixtures/", "docs/examples/", "docs/generated/"]
warn_unused_ignores = true
show_error_codes = true

[tool.pydoclint]
# Verifies docstrings match the signature, which interrogate cannot: interrogate counts
# docstrings, this one reads them.
style = "google"
arg-type-hints-in-docstring = false
check-return-types = false
check-yield-types = false

{% if project_layout == "service" -%}
[tool.deptry.per_rule_ignores]
# uvicorn is the server the container runs, invoked as a command rather than imported.
# Declared because deploying without it fails; unimported because nothing should import it.
DEP002 = ["uvicorn"]

{% endif -%}
[tool.bandit]
# Read by the checks nox session, which passes `-c pyproject.toml`. B101 is the
# bandit counterpart of the ruff S101 ignore above: asserts are how tests assert.
skips = ["B101"]

[tool.pip-audit]
# Advisory IDs to ignore, read by the checks nox session. PYSEC-2022-42969 is a
# won't-fix ReDoS in py, pulled in transitively by interrogate.
ignore-vulns = ["PYSEC-2022-42969"]

[tool.pytest.ini_options]
python_files = ["test_*.py"]
{% if project_layout == "ml" -%}
# `--nbmake` executes the notebooks as tests. That is what keeps the notebook tooling honest:
# the dependency is exercised rather than merely declared, and a notebook that stops running
# fails the suite instead of rotting quietly.
addopts = "--cov --nbmake"
testpaths = ["tests", "notebooks"]
{% else -%}
addopts = "--cov"
testpaths = ["tests"]
{% endif %}
[tool.coverage.run]
branch = true
parallel = true
source = ["src", "tests"]

[tool.coverage.paths]
equivalent = ["src", "__pypackages__"]

[tool.coverage.report]
precision = 2
omit = ["src/*/__init__.py", "tests/__init__.py"]

[tool.coverage.json]
output = "htmlcov/coverage.json"
