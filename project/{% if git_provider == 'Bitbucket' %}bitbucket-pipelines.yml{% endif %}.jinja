image: python:3.11

pipelines:
  default:
    - step:
        name: Test
        caches:
          - pip
        script:
          {%- if package_manager == "PDM" %}
          - pip install pdm uv
          - pdm install
          - pdm tests
          {%- else %}
          - pip install uv
          - uv sync
          - uv run nox -s tests
          {%- endif %}
        artifacts:
          - coverage.xml
          - htmlcov/**

    - step:
        name: Quality Checks
        caches:
          - pip
        script:
          {%- if package_manager == "PDM" %}
          - pip install pdm uv
          - pdm install
          - pdm checks
          {%- else %}
          - pip install uv
          - uv sync
          - uv run nox -s checks
          {%- endif %}

  branches:
    main:
      - step:
          name: Test
          caches:
            - pip
          script:
            {%- if package_manager == "PDM" %}
            - pip install pdm uv
            - pdm install
            - pdm tests
            {%- else %}
            - pip install uv
            - uv sync
            - uv run nox -s tests
            {%- endif %}
          artifacts:
            - coverage.xml
            - htmlcov/**

      - step:
          name: Quality Checks
          caches:
            - pip
          script:
            {%- if package_manager == "PDM" %}
            - pip install pdm uv
            - pdm install
            - pdm checks
            {%- else %}
            - pip install uv
            - uv sync
            - uv run nox -s checks
            {%- endif %}

      - step:
          name: Build Documentation
          caches:
            - pip
          script:
            {%- if package_manager == "PDM" %}
            - pip install pdm uv
            - pdm install
            - pdm docs build
            {%- else %}
            - pip install uv
            - uv sync
            - uv run nox -s docs -- build
            {%- endif %}
          artifacts:
            - site/**

  tags:
    '*':
      - step:
          name: Test
          caches:
            - pip
          script:
            {%- if package_manager == "PDM" %}
            - pip install pdm uv
            - pdm install
            - pdm tests
            {%- else %}
            - pip install uv
            - uv sync
            - uv run nox -s tests
            {%- endif %}

      - step:
          name: Quality Checks
          caches:
            - pip
          script:
            {%- if package_manager == "PDM" %}
            - pip install pdm uv
            - pdm install
            - pdm checks
            {%- else %}
            - pip install uv
            - uv sync
            - uv run nox -s checks
            {%- endif %}
      {%- if publish_pypi %}

      # The `release` nox session is the local kickoff that tags the commit. The
      # pipeline is the only publisher, so it just builds and uploads the tag,
      # and the steps above have to pass before this one runs.
      - step:
          name: Release to PyPI
          caches:
            - pip
          script:
            {%- if package_manager == "PDM" %}
            - pip install pdm uv twine
            - pdm build
            {%- else %}
            - pip install uv twine
            - uv build
            {%- endif %}
            - twine upload --skip-existing dist/*
          trigger: manual
      {%- endif %}

definitions:
  caches:
    pip: ~/.cache/pip
