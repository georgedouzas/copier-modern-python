stages:
  - test
  - quality
  - docs
  - release

variables:
  PIP_CACHE_DIR: "$CI_PROJECT_DIR/.cache/pip"

cache:
  paths:
    - .cache/pip
    - .nox

.python_template: &python_template
  image: python:{{ python_test_versions[0] }}
  before_script:
    {%- if package_manager == "PDM" %}
    - pip install pdm uv
    {%- else %}
    - pip install uv
    {%- endif %}

test:
  <<: *python_template
  stage: test
  script:
    {%- if package_manager == "PDM" %}
    - pdm install
    - pdm tests
    {%- else %}
    - uv sync
    - uv run nox -s tests
    {%- endif %}
  coverage: '/TOTAL.*\s+(\d+%)$/'
  artifacts:
    reports:
      coverage_report:
        coverage_format: cobertura
        path: coverage.xml

quality:
  <<: *python_template
  stage: quality
  script:
    {%- if package_manager == "PDM" %}
    - pdm install
    - pdm checks
    {%- else %}
    - uv sync
    - uv run nox -s checks
    {%- endif %}

docs:
  <<: *python_template
  stage: docs
  script:
    {%- if package_manager == "PDM" %}
    - pdm install
    - pdm docs build
    {%- else %}
    - uv sync
    - uv run nox -s docs -- build
    {%- endif %}
  artifacts:
    paths:
      - site/
  only:
    - main

pages:
  stage: docs
  dependencies:
    - docs
  script:
    - mv site public
  artifacts:
    paths:
      - public
  only:
    - main
{%- if publish_pypi %}

# The `release` nox session is the local kickoff that tags the commit. The
# pipeline is the only publisher, so it just builds and uploads the tag, and it
# only reaches this stage once the test and quality stages are green.
release:
  <<: *python_template
  stage: release
  script:
    - pip install twine
    {%- if package_manager == "PDM" %}
    - pdm build
    {%- else %}
    - uv build
    {%- endif %}
    - twine upload --skip-existing dist/*
  only:
    - tags
  when: manual
{%- endif %}
